{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/gate-shell.mjs",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/lint-edited-file.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-feedback.mjs",
        "loop_limit": 3
      }
    ]
  }
}
